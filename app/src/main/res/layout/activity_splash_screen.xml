<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary"
    android:clipToPadding="false"
    tools:context=".SplashScreenActivity">

    <View
        android:id="@+id/circleTopRight"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/header_circle_light"
        android:translationX="110dp"
        android:translationY="-90dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/circleBottomLeft"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/header_circle_dark"
        android:translationX="-90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/dotAmber"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="230dp"
        android:layout_marginEnd="72dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dotSoft"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="180dp"
        android:background="@drawable/shape_circle"
        android:backgroundTint="@color/header_outline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo_tanya"
        app:layout_constraintBottom_toTopOf="@id/tvAppName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/brand_name"
        android:textColor="@color/on_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvSlogan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <TextView
        android:id="@+id/tvSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/splash_slogan"
        android:textColor="@color/on_primary_muted"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppName" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:contentDescription="@string/cd_loading"
        android:indeterminate="true"
        app:indicatorColor="@color/on_primary"
        app:indicatorSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSlogan"
        app:trackColor="@color/header_circle_light"
        app:trackThickness="4dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
