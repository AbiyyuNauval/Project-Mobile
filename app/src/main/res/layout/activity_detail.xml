<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".DetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:liftOnScroll="false">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:layout_scrollFlags="scroll|enterAlways"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"
            app:subtitleTextColor="@color/on_primary_muted"
            app:titleTextAppearance="@style/TextAppearance.TanyaBareng.Toolbar.Title"
            app:titleTextColor="@color/on_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@color/primary_container"
                        android:contentDescription="@string/cd_avatar"
                        android:scaleType="centerCrop"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.TanyaBareng.Circle" />

                    <TextView
                        android:id="@+id/tvUser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/detail_q_user"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvMeta"
                        app:layout_constraintEnd_toStartOf="@id/tvSubject"
                        app:layout_constraintStart_toEndOf="@id/imgAvatar"
                        app:layout_constraintTop_toTopOf="@id/imgAvatar"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_q_meta"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/imgAvatar"
                        app:layout_constraintEnd_toEndOf="@id/tvUser"
                        app:layout_constraintStart_toStartOf="@id/tvUser"
                        app:layout_constraintTop_toBottomOf="@id/tvUser" />

                    <TextView
                        android:id="@+id/tvSubject"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/subj_math_bg"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="4dp"
                        android:text="@string/subject_math"
                        android:textColor="@color/subj_math_fg"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/imgAvatar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/imgAvatar" />

                    <TextView
                        android:id="@+id/tvQuestionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/detail_q_title"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgAvatar" />

                    <TextView
                        android:id="@+id/tvQuestionBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/detail_q_body"
                        android:textColor="@color/text_body"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvQuestionTitle" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutQuestionPhoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_photo_paper"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvQuestionBody">

                        <TextView
                            android:id="@+id/tvPhotoLabel"
                            style="@style/TanyaBareng.PhotoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_question_photo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvHand1"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hand_question_1"
                            app:layout_constraintEnd_toStartOf="@id/tvPhotoLabel"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvHand2"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hand_question_2"
                            android:textSize="21sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvHand1" />

                        <TextView
                            android:id="@+id/tvHand3"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/hand_question_3"
                            android:textColor="@color/ink_red"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvHand2" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoteQuestion"
                        style="@style/TanyaBareng.VoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="14dp"
                        android:text="12"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutQuestionPhoto" />

                    <TextView
                        android:id="@+id/tvViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/detail_q_views"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="@id/btnVoteQuestion"
                        app:layout_constraintStart_toEndOf="@id/btnVoteQuestion"
                        app:layout_constraintTop_toTopOf="@id/btnVoteQuestion" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAnswerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardQuestion"
                android:text="@string/detail_answers_title_static" />

            <TextView
                android:id="@+id/tvSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/detail_sort"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/tvAnswerCount"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnswer1"
                style="@style/TanyaBareng.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAnswerCount"
                app:strokeColor="@color/secondary"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvBest1"
                        style="@style/TanyaBareng.BestLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAnswerAvatar1"
                        style="@style/TanyaBareng.Avatar"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:backgroundTint="@color/surface_variant"
                        android:text="@string/a1_initials"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/tvBest1" />

                    <TextView
                        android:id="@+id/tvAnswerUser1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/a1_user"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvAnswerMeta1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvAnswerAvatar1"
                        app:layout_constraintTop_toTopOf="@id/tvAnswerAvatar1"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvAnswerMeta1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/a1_meta"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/tvAnswerAvatar1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvAnswerUser1"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerUser1" />

                    <TextView
                        android:id="@+id/tvBody1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/a1_body"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerAvatar1" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutAnswerPhoto1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_photo_paper"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBody1">

                        <TextView
                            android:id="@+id/tvAnswerPhotoLabel1"
                            style="@style/TanyaBareng.PhotoLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_answer_photo"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvAnswerHand1_1"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hand_answer_1"
                            app:layout_constraintEnd_toStartOf="@id/tvAnswerPhotoLabel1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvAnswerHand2_1"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hand_answer_2"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvAnswerHand1_1" />

                        <TextView
                            android:id="@+id/tvAnswerHand3_1"
                            style="@style/TanyaBareng.Handwriting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/hand_answer_3"
                            android:textColor="@color/primary"
                            android:textSize="21sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvAnswerHand2_1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoteAnswer1"
                        style="@style/TanyaBareng.VoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:text="9"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/layoutAnswerPhoto1" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnswer2"
                style="@style/TanyaBareng.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAnswer1">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAnswerAvatar2"
                        style="@style/TanyaBareng.Avatar"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:backgroundTint="@color/surface_variant"
                        android:text="@string/a2_initials"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAnswerUser2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/a2_user"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvAnswerMeta2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvAnswerAvatar2"
                        app:layout_constraintTop_toTopOf="@id/tvAnswerAvatar2"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvAnswerMeta2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/a2_meta"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/tvAnswerAvatar2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvAnswerUser2"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerUser2" />

                    <TextView
                        android:id="@+id/tvBody2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/a2_body"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerAvatar2" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoteAnswer2"
                        style="@style/TanyaBareng.VoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:text="4"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBody2" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAnswer3"
                style="@style/TanyaBareng.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardAnswer2">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAnswerAvatar3"
                        style="@style/TanyaBareng.Avatar"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:backgroundTint="@color/surface_variant"
                        android:text="@string/a3_initials"
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvAnswerUser3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/a3_user"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvAnswerMeta3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvAnswerAvatar3"
                        app:layout_constraintTop_toTopOf="@id/tvAnswerAvatar3"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvAnswerMeta3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/a3_meta"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@id/tvAnswerAvatar3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvAnswerUser3"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerUser3" />

                    <TextView
                        android:id="@+id/tvBody3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/a3_body"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvAnswerAvatar3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoteAnswer3"
                        style="@style/TanyaBareng.VoteButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="12dp"
                        android:text="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvBody3" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_bar"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttach"
            style="@style/TanyaBareng.IconButton.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_attach_photo"
            app:icon="@drawable/ic_camera"
            app:layout_constraintBottom_toBottomOf="@id/tilAnswer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilAnswer" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAnswer"
            style="@style/TanyaBareng.FormField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintEnd_toStartOf="@id/btnSend"
            app:layout_constraintStart_toEndOf="@id/btnAttach"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_answer"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/outline"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/TanyaBareng.IconButton.Filled"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_send_answer"
            app:icon="@drawable/ic_send"
            app:layout_constraintBottom_toBottomOf="@id/tilAnswer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tilAnswer" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
