    </style>
    <style name="TextAppearance.TanyaBareng.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="TextAppearance.TanyaBareng.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
