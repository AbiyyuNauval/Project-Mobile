        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="TextAppearance.TanyaBareng.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TanyaBareng.FormLabel" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TanyaBareng.SectionHeader" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TanyaBareng.FormField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorTextColor">@color/error</item>
        <item name="boxStrokeErrorColor">@color/error</item>
    </style>

    <style name="TanyaBareng.LevelButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/toggle_level_bg</item>
        <item name="android:textColor">@color/toggle_level_text</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TanyaBareng.PhotoPickButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="iconSize">18dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TanyaBareng.IconButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="strokeColor">@color/dashed</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TanyaBareng.IconButton.Filled" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TanyaBareng.PhotoLabel" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/label_dark</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TanyaBareng.Handwriting" parent="">
        <item name="android:fontFamily">casual</item>
        <item name="android:textColor">@color/ink_blue</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TanyaBareng.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TanyaBareng.Avatar" parent="">
        <item name="android:background">@drawable/shape_circle</item>
        <item name="android:backgroundTint">@color/primary_container</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TanyaBareng.VoteButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/dashed</item>
        <item name="cornerRadius">10dp</item>
        <item name="icon">@drawable/ic_arrow_up</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="TanyaBareng.AnswerCount" parent="">
        <item name="drawableStartCompat">@drawable/ic_chat</item>
        <item name="drawableTint">@color/text_secondary</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TanyaBareng.BestLabel" parent="">
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/secondary_container</item>
        <item name="drawableStartCompat">@drawable/ic_check_small</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:text">@string/label_best_answer</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TanyaBareng.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="android:textColor">@color/chip_selection_text</item>
        <item name="chipBackgroundColor">@color/chip_selection_bg</item>
        <item name="chipStrokeColor">@color/chip_selection_stroke</item>
        <item name="checkedIcon">@drawable/ic_check</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIconTint">@color/chip_selection_text</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="chipIconSize">16dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TanyaBareng.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/TanyaBareng.BottomNav.ActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.TanyaBareng.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.TanyaBareng.BottomNav</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="TanyaBareng.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
    </style>

    <style name="TextAppearance.TanyaBareng.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.TanyaBareng.BottomNav.Active" parent="TextAppearance.TanyaBareng.BottomNav">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.TanyaBareng.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
