        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.TanyaBareng.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.TanyaBareng.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.TanyaBareng.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.TanyaBareng.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.TanyaBareng.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.TanyaBareng.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.TanyaBareng.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.TanyaBareng.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.TanyaBareng.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.TanyaBareng.LabelSmall</item>
    </style>

    <style name="Theme.Abiyyu_3TIA.Splash">
        <item name="android:windowBackground">@color/primary</item>
    </style>

    <style name="TextAppearance.TanyaBareng.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
