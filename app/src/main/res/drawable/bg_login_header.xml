<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:right="-70dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="@color/header_circle_light" />
        </shape>
    </item>
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="top|start"
        android:left="-40dp"
        android:top="170dp">
        <shape android:shape="oval">
            <solid android:color="@color/header_circle_dark" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="top|end"
        android:right="64dp"
        android:top="140dp">
        <shape android:shape="oval">
            <solid android:color="@color/secondary" />
        </shape>
    </item>
</layer-list>
